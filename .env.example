# Telegram Configuration
TELEGRAM_TOKEN=your_bot_token_here
ADMIN_USER_ID=your_telegram_id_here

# SSH Configuration
HOST_SSH_URL=ssh://user@host_ip:22
# Path to private key inside the container or local machine
SSH_KEY_PATH=./keys/id_rsa

# Database Configuration
# For run_local.sh, this will point to your local postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tmux_ssh_telegram

# Bot Settings (can also be modified via /config)
BATCH_INTERVAL_MS=2000
IDLE_THRESHOLD_MS=5000
POLL_INTERVAL_MS=500
MAX_LOG_LINES=100
